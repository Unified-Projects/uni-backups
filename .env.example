# Uni-Backups Environment Configuration

# Restic password for encrypting backups (REQUIRED)
UNI_BACKUPS_RESTIC_PASSWORD=your-secure-restic-password

# API token for authenticating web/API requests (REQUIRED for API startup)
UNI_BACKUPS_API_TOKEN=change-me-to-a-long-random-token
# UNI_BACKUPS_API_TOKEN_FILE=/run/secrets/uni_backups_api_token

# Application URL (where the app is accessible)
UNI_BACKUPS_URL=http://localhost

# Config file path
UNI_BACKUPS_CONFIG_FILE=/app/config/backups.yml
