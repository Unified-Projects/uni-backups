{
  "name": "@uni-backups/shared",
  "version": "0.0.2",
  "private": true,
  "type": "module",
  "exports": {
    "./config": {
      "types": "./src/config/index.ts",
      "default": "./src/config/index.ts"
    },
    "./config/*": {
      "types": "./src/config/*.ts",
      "default": "./src/config/*.ts"
    },
    "./redis": {
      "types": "./src/redis/index.ts",
      "default": "./src/redis/index.ts"
    },
    "./redis/*": {
      "types": "./src/redis/*.ts",
      "default": "./src/redis/*.ts"
    }
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "test:docker": "vitest run -c vitest.docker.config.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "ioredis": "^6.0.0",
    "yaml": "^2.9.1",
    "zod": "^3.25.76"
  },
  "peerDependencies": {
    "@uni-backups/queue": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@uni-backups/queue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^25.9.9",
    "@uni-backups/queue": "workspace:*",
    "@vitest/coverage-v8": "^5.0.5",
    "fast-check": "^4.10.2",
    "ioredis-mock": "^8.13.1",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.12"
  }
}
